---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const pad = (n: number) => String(n).padStart(2, '0');
const monthDay = (d: Date) => `${pad(d.getUTCMonth() + 1)}.${pad(d.getUTCDate())}`;
---

<BaseLayout
  title="Writing"
  current="writing"
  description={`${posts.length} posts written between 2005 and 2014, kept as published.`}
>
  <main>
    <div class="intro">
      <h1>Writing</h1>
      <p>
        {posts.length} posts, written between {years[years.length - 1]} and {years[0]} and kept as
        published. Much of it has aged — the versions, the links, the opinions — but it's where
        it's always been.
      </p>
    </div>

    <div class="years">
      {
        years.map((year) => (
          <section class="year">
            <h2>{year}</h2>
            <div class="entries">
              {byYear.get(year)!.map((post) => (
                <div class="entry">
                  <span class="date">{monthDay(post.data.pubDate)}</span>
                  <a href={post.data.permalink}>{post.data.title}</a>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 60px;
    padding: clamp(48px, 7vw, 72px) 0;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 620px;
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 44px);
    line-height: 1.1;
  }

  .intro p {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
  }

  .years {
    display: flex;
    flex-direction: column;
    gap: 42px;
  }

  .year {
    display: flex;
    gap: clamp(20px, 4vw, 56px);
    align-items: flex-start;
  }

  .year h2 {
    margin: 0;
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--accent);
    width: 60px;
    flex-shrink: 0;
    padding-top: 15px;
  }

  .entries {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
  }

  .entry {
    display: flex;
    gap: clamp(12px, 2vw, 26px);
    align-items: baseline;
    padding: 13px 0;
    border-top: 1px solid var(--hairline);
  }

  .date {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    width: 46px;
    flex-shrink: 0;
  }

  .entry a {
    font-size: 17px;
    color: var(--soft);
  }

  .entry a:hover {
    color: var(--accent);
  }
</style>
