---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="That page isn't here.">
  <main>
    <h1>Not found</h1>
    <p>
      That page isn't here. It may have moved when this site was rebuilt, or it may never have
      existed. The <a href="/writing/">archive index</a> lists everything that's still up.
    </p>
  </main>
</BaseLayout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: var(--measure);
    padding: clamp(56px, 9vw, 92px) 0;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 44px);
    line-height: 1.1;
  }

  p {
    margin: 0;
    font-size: 19px;
  }
</style>
